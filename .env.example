# ID of the Google Sheet (the long string in its URL). Leave unset to build from data/seed.json.
SHEET_ID=
# Full JSON of a Google Cloud service-account key, pasted as one line. The sheet must be shared with the
# service account's email (Editor) so the site can read every tab and append to "submissions".
GOOGLE_SERVICE_ACCOUNT_JSON=
# Secret for the nightly rebuild endpoint (/api/revalidate?secret=...). Vercel's cron sends Authorization: Bearer $CRON_SECRET automatically.
CRON_SECRET=
# Where "Ask Rithm for an intro" points.
NEXT_PUBLIC_CONTACT_EMAIL=info@therithmproject.org
